rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A meglévő és új ingatlanképek nyilvánosan olvashatók.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Új fájlt csak a saját felhasználói mappába lehet írni.
    match /properties/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Minden más írás tiltva.
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
