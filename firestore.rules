rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validPostStatus(status) {
      return status in ["active", "draft", "sold", "inactive"];
    }

    function validListingType(data) {
      return !("listingType" in data) || data.listingType in ["sale", "rent"];
    }

    match /posts/{postId} {
      // Nyilvánosan kizárólag az aktív hirdetések olvashatók.
      // A tulajdonos a saját hirdetéseit státusztól függetlenül látja,
      // az admin pedig minden hirdetéshez hozzáfér.
      allow read: if resource.data.status == "active"
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow create: if verified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.featured == false
        && request.resource.data.listingType in ["sale", "rent"]
        && validPostStatus(request.resource.data.status);

      allow update: if verified()
        && request.resource.data.userId == resource.data.userId
        && validPostStatus(request.resource.data.status)
        && validListingType(request.resource.data)
        && (
          isAdmin()
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.featured == resource.data.featured
          )
        );

      allow delete: if verified()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user";

      allow update: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
          )
          || isAdmin()
        );

      allow delete: if verified()
        && (request.auth.uid == userId || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
