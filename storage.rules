rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // Az ingatlanképek nyilvánosan megjeleníthetők a hirdetésekben.
    match /{allPaths=**} {
      allow read: if true;
    }

    match /properties/{userId}/{fileName} {
      // Csak megerősített tulajdonos tölthet fel, és csak valódi webes képformátumot.
      allow create, update: if verifiedOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if verifiedOwner(userId);
    }

    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
